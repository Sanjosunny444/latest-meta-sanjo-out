#!/bin/sh
case "$1" in
    start)
        wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant/wpa_supplicant.conf
        sleep 2
        udhcpc -i wlan0 -b
        ;;
    stop)
        killall wpa_supplicant 2>/dev/null
        killall udhcpc 2>/dev/null
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
exit 0
